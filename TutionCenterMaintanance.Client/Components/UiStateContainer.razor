@namespace TutionCenterMaintanance.Client.Components

@if (Loading)
{
    <div class="d-flex flex-column align-center justify-center py-12 gap-3">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        <span style="color: var(--color-ink-muted); font-size: 0.88rem; font-weight: 500;">
            @LoadingText
        </span>
    </div>
}
else if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="pa-6 rounded-xl text-center my-4"
         style="background-color: var(--color-error-soft); border: 1px solid rgba(239, 68, 68, 0.25);">
        <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Color="Color.Error" Size="Size.Large" Class="mb-2" />
        <div style="font-weight: 700; color: var(--color-error); font-size: 1rem;">@ErrorTitle</div>
        <div style="color: var(--color-ink-secondary); font-size: 0.85rem; margin-top: 4px;">@ErrorMessage</div>
        @if (OnRetry.HasDelegate)
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="OnRetry"
                       Class="mt-3"
                       Style="text-transform: none; border-radius: 8px; font-weight: 600;">
                Retry
            </MudButton>
        }
    </div>
}
else if (IsEmpty)
{
    <div class="pa-12 text-center rounded-xl my-4"
         style="background-color: var(--color-paper-subtle); border: 1px dashed var(--color-rule);">
        <MudIcon Icon="@EmptyIcon" Size="Size.Large" Style="color: var(--color-ink-muted); font-size: 40px;" Class="mb-2" />
        <div style="font-weight: 600; color: var(--color-ink); font-size: 0.95rem;">@EmptyTitle</div>
        <div style="color: var(--color-ink-muted); font-size: 0.82rem; margin-top: 2px;">@EmptyMessage</div>
        @if (EmptyAction != null)
        {
            <div class="mt-3">
                @EmptyAction
            </div>
        }
    </div>
}
else
{
    @ChildContent
}

@code {
    [Parameter] public bool Loading { get; set; }
    [Parameter] public string LoadingText { get; set; } = "Loading data...";

    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public string ErrorTitle { get; set; } = "Unable to load data";
    [Parameter] public EventCallback OnRetry { get; set; }

    [Parameter] public bool IsEmpty { get; set; }
    [Parameter] public string EmptyTitle { get; set; } = "No records found";
    [Parameter] public string EmptyMessage { get; set; } = "There are no records to display at this time.";
    [Parameter] public string EmptyIcon { get; set; } = Icons.Material.Filled.Inbox;
    [Parameter] public RenderFragment? EmptyAction { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }
}

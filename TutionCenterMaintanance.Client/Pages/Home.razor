@page "/"
@attribute [Authorize]
@inject IApiService ApiService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Dashboard - Sai Tuition Center</PageTitle>

<!-- Welcoming Top Bar -->
<div class="mb-6 d-flex flex-column flex-sm-row justify-space-between align-start align-sm-center gap-3">
    <div>
        <h1 style="font-size: 1.5rem; font-weight: 700; color: var(--color-ink); margin: 0; letter-spacing: -0.02em;">
            Center overview & operations
        </h1>
        <p style="font-size: 0.88rem; color: var(--color-ink-secondary); margin: 4px 0 0 0;">
            Real-time status of students, daily attendance, tests, and fee collections
        </p>
    </div>
    <div class="d-flex align-center gap-2">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Outlined.PersonAdd"
                   OnClick="@(() => Navigation.NavigateTo("/students"))"
                   Style="border-radius: 10px; font-weight: 600; text-transform: none; padding: 8px 16px;">
            Add student
        </MudButton>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Default"
                   StartIcon="@Icons.Material.Outlined.FactCheck"
                   OnClick="@(() => Navigation.NavigateTo("/attendance"))"
                   Style="border-radius: 10px; font-weight: 600; text-transform: none; border-color: var(--color-rule); padding: 8px 16px;">
            Mark attendance
        </MudButton>
    </div>
</div>

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4 rounded-pill" />
}
else if (_stats != null)
{
    <!-- Stat KPI Cards (Hallmark Anti-AI-Slop: Untracked sentence-case labels, soft icons, tabular numbers) -->
    <MudGrid Class="mb-6">
        <!-- Active Students -->
        <MudItem xs="12" sm="6" md="3">
            <div class="pa-4 rounded-xl card-hover-subtle"
                 style="background-color: var(--color-surface); border: 1px solid var(--color-rule); box-shadow: var(--shadow-sm); border-radius: 16px;">
                <div class="d-flex justify-space-between align-start mb-2">
                    <span style="font-size: 0.85rem; font-weight: 600; color: var(--color-ink-secondary);">
                        Active students
                    </span>
                    <div style="width: 42px; height: 42px; border-radius: 12px; background-color: var(--color-primary-soft); display: flex; align-items: center; justify-content: center;">
                        <MudIcon Icon="@Icons.Material.Outlined.School" Style="color: var(--color-primary); font-size: 22px;" />
                    </div>
                </div>
                <div style="font-size: 1.85rem; font-weight: 700; color: var(--color-ink); letter-spacing: -0.02em; font-variant-numeric: tabular-nums;">
                    @_stats.TotalActiveStudents
                </div>
                <div class="d-flex align-center gap-1 mt-1">
                    <span class="adorable-badge adorable-badge-primary" style="font-size: 0.72rem; padding: 2px 8px;">
                        UKG to Grade 12
                    </span>
                </div>
            </div>
        </MudItem>

        <!-- Today's Attendance -->
        <MudItem xs="12" sm="6" md="3">
            <div class="pa-4 rounded-xl card-hover-subtle"
                 style="background-color: var(--color-surface); border: 1px solid var(--color-rule); box-shadow: var(--shadow-sm); border-radius: 16px;">
                <div class="d-flex justify-space-between align-start mb-2">
                    <span style="font-size: 0.85rem; font-weight: 600; color: var(--color-ink-secondary);">
                        Today's attendance
                    </span>
                    <div style="width: 42px; height: 42px; border-radius: 12px; background-color: var(--color-success-soft); display: flex; align-items: center; justify-content: center;">
                        <MudIcon Icon="@Icons.Material.Outlined.CheckCircleOutline" Style="color: var(--color-success); font-size: 22px;" />
                    </div>
                </div>
                <div style="font-size: 1.85rem; font-weight: 700; color: var(--color-ink); letter-spacing: -0.02em; font-variant-numeric: tabular-nums;">
                    @_stats.TodayAttendancePercentage%
                </div>
                <div class="d-flex align-center gap-1 mt-1">
                    <span class="adorable-badge adorable-badge-success" style="font-size: 0.72rem; padding: 2px 8px;">
                        @_stats.TodayPresentCount present, @_stats.TodayAbsentCount absent
                    </span>
                </div>
            </div>
        </MudItem>

        <!-- Fees Collected & Financials -->
        <MudItem xs="12" sm="6" md="3">
            <div class="pa-4 rounded-xl card-hover-subtle cursor-pointer"
                 @onclick="@(() => Navigation.NavigateTo("/financials"))"
                 title="Click to view full financial report"
                 style="background-color: var(--color-surface); border: 1px solid var(--color-rule); box-shadow: var(--shadow-sm); border-radius: 16px;">
                <div class="d-flex justify-space-between align-start mb-2">
                    <span style="font-size: 0.85rem; font-weight: 600; color: var(--color-ink-secondary);">
                        Monthly collections
                    </span>
                    <div style="width: 42px; height: 42px; border-radius: 12px; background-color: var(--color-info-soft); display: flex; align-items: center; justify-content: center;">
                        <MudIcon Icon="@Icons.Material.Outlined.Payments" Style="color: var(--color-info); font-size: 22px;" />
                    </div>
                </div>
                <div style="font-size: 1.85rem; font-weight: 700; color: var(--color-ink); letter-spacing: -0.02em; font-variant-numeric: tabular-nums;">
                    ₹@_stats.TotalFeesCollectedMonth.ToString("N0")
                </div>
                <div class="d-flex align-center justify-space-between mt-1" style="font-size: 0.72rem; color: var(--color-ink-muted);">
                    <span>Expenses ₹@_stats.TotalExpensesMonth.ToString("N0")</span>
                    <span style="font-weight: 600; color: @(_stats.NetOperatingProfitMonth >= 0 ? "var(--color-success)" : "var(--color-error)");">
                        Net ₹@_stats.NetOperatingProfitMonth.ToString("N0")
                    </span>
                </div>
            </div>
        </MudItem>

        <!-- Active Batches -->
        <MudItem xs="12" sm="6" md="3">
            <div class="pa-4 rounded-xl card-hover-subtle"
                 style="background-color: var(--color-surface); border: 1px solid var(--color-rule); box-shadow: var(--shadow-sm); border-radius: 16px;">
                <div class="d-flex justify-space-between align-start mb-2">
                    <span style="font-size: 0.85rem; font-weight: 600; color: var(--color-ink-secondary);">
                        Active batches
                    </span>
                    <div style="width: 42px; height: 42px; border-radius: 12px; background-color: var(--color-warning-soft); display: flex; align-items: center; justify-content: center;">
                        <MudIcon Icon="@Icons.Material.Outlined.Groups" Style="color: var(--color-warning); font-size: 22px;" />
                    </div>
                </div>
                <div style="font-size: 1.85rem; font-weight: 700; color: var(--color-ink); letter-spacing: -0.02em; font-variant-numeric: tabular-nums;">
                    @_stats.TotalBatches
                </div>
                <div class="d-flex align-center gap-1 mt-1">
                    <span class="adorable-badge adorable-badge-warning" style="font-size: 0.72rem; padding: 2px 8px;">
                        @_stats.TotalTeachers teachers assigned
                    </span>
                </div>
            </div>
        </MudItem>
    </MudGrid>

    <MudGrid>
        <!-- Quick Operations Section -->
        <MudItem xs="12" md="7">
            <div class="pa-5 rounded-xl h-100"
                 style="background-color: var(--color-surface); border: 1px solid var(--color-rule); box-shadow: var(--shadow-sm); border-radius: 16px;">
                <div class="d-flex justify-space-between align-center mb-4">
                    <h2 style="font-size: 1.1rem; font-weight: 700; color: var(--color-ink); margin: 0;">
                        Quick operations
                    </h2>
                    <span style="font-size: 0.78rem; color: var(--color-ink-muted);">Frequent tasks</span>
                </div>

                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px;">
                    <!-- Student Records -->
                    <div class="pa-3 rounded-lg cursor-pointer card-hover-subtle"
                         style="border: 1px solid var(--color-rule); background-color: var(--color-paper-subtle); border-radius: 12px;"
                         @onclick="@(() => Navigation.NavigateTo("/students"))">
                        <div class="d-flex align-center gap-3">
                            <div style="width: 38px; height: 38px; border-radius: 10px; background-color: var(--color-primary-soft); display: flex; align-items: center; justify-content: center;">
                                <MudIcon Icon="@Icons.Material.Outlined.Badge" Style="color: var(--color-primary); font-size: 20px;" />
                            </div>
                            <div>
                                <div style="font-weight: 600; font-size: 0.88rem; color: var(--color-ink);">Students</div>
                                <div style="font-size: 0.74rem; color: var(--color-ink-muted);">Directory & profiles</div>
                            </div>
                        </div>
                    </div>

                    <!-- Bulk Marks -->
                    <div class="pa-3 rounded-lg cursor-pointer card-hover-subtle"
                         style="border: 1px solid var(--color-rule); background-color: var(--color-paper-subtle); border-radius: 12px;"
                         @onclick="@(() => Navigation.NavigateTo("/marks/bulk-entry"))">
                        <div class="d-flex align-center gap-3">
                            <div style="width: 38px; height: 38px; border-radius: 10px; background-color: var(--color-success-soft); display: flex; align-items: center; justify-content: center;">
                                <MudIcon Icon="@Icons.Material.Outlined.FormatListNumbered" Style="color: var(--color-success); font-size: 20px;" />
                            </div>
                            <div>
                                <div style="font-weight: 600; font-size: 0.88rem; color: var(--color-ink);">Enter marks</div>
                                <div style="font-size: 0.74rem; color: var(--color-ink-muted);">Bulk test scores</div>
                            </div>
                        </div>
                    </div>

                    <!-- Fee Payments -->
                    <div class="pa-3 rounded-lg cursor-pointer card-hover-subtle"
                         style="border: 1px solid var(--color-rule); background-color: var(--color-paper-subtle); border-radius: 12px;"
                         @onclick="@(() => Navigation.NavigateTo("/fees"))">
                        <div class="d-flex align-center gap-3">
                            <div style="width: 38px; height: 38px; border-radius: 10px; background-color: var(--color-info-soft); display: flex; align-items: center; justify-content: center;">
                                <MudIcon Icon="@Icons.Material.Outlined.ReceiptLong" Style="color: var(--color-info); font-size: 20px;" />
                            </div>
                            <div>
                                <div style="font-weight: 600; font-size: 0.88rem; color: var(--color-ink);">Fee payments</div>
                                <div style="font-size: 0.74rem; color: var(--color-ink-muted);">Receipts & dues</div>
                            </div>
                        </div>
                    </div>

                    <!-- Report Cards -->
                    <div class="pa-3 rounded-lg cursor-pointer card-hover-subtle"
                         style="border: 1px solid var(--color-rule); background-color: var(--color-paper-subtle); border-radius: 12px;"
                         @onclick="@(() => Navigation.NavigateTo("/report-cards"))">
                        <div class="d-flex align-center gap-3">
                            <div style="width: 38px; height: 38px; border-radius: 10px; background-color: var(--color-secondary-soft); display: flex; align-items: center; justify-content: center;">
                                <MudIcon Icon="@Icons.Material.Outlined.Description" Style="color: var(--color-secondary); font-size: 20px;" />
                            </div>
                            <div>
                                <div style="font-weight: 600; font-size: 0.88rem; color: var(--color-ink);">Report cards</div>
                                <div style="font-size: 0.74rem; color: var(--color-ink-muted);">Performance sheets</div>
                            </div>
                        </div>
                    </div>

                    <!-- WhatsApp Dispatch -->
                    <div class="pa-3 rounded-lg cursor-pointer card-hover-subtle"
                         style="border: 1px solid var(--color-rule); background-color: var(--color-paper-subtle); border-radius: 12px;"
                         @onclick="@(() => Navigation.NavigateTo("/whatsapp"))">
                        <div class="d-flex align-center gap-3">
                            <div style="width: 38px; height: 38px; border-radius: 10px; background-color: var(--color-success-soft); display: flex; align-items: center; justify-content: center;">
                                <MudIcon Icon="@Icons.Custom.Brands.WhatsApp" Style="color: var(--color-success); font-size: 20px;" />
                            </div>
                            <div>
                                <div style="font-weight: 600; font-size: 0.88rem; color: var(--color-ink);">WhatsApp</div>
                                <div style="font-size: 0.74rem; color: var(--color-ink-muted);">Notify parents</div>
                            </div>
                        </div>
                    </div>

                    <!-- Class Batches -->
                    <div class="pa-3 rounded-lg cursor-pointer card-hover-subtle"
                         style="border: 1px solid var(--color-rule); background-color: var(--color-paper-subtle); border-radius: 12px;"
                         @onclick="@(() => Navigation.NavigateTo("/batches"))">
                        <div class="d-flex align-center gap-3">
                            <div style="width: 38px; height: 38px; border-radius: 10px; background-color: var(--color-warning-soft); display: flex; align-items: center; justify-content: center;">
                                <MudIcon Icon="@Icons.Material.Outlined.Groups" Style="color: var(--color-warning); font-size: 20px;" />
                            </div>
                            <div>
                                <div style="font-weight: 600; font-size: 0.88rem; color: var(--color-ink);">Batches</div>
                                <div style="font-size: 0.74rem; color: var(--color-ink-muted);">Timings & tutors</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </MudItem>

        <!-- Upcoming Tests / Assessments -->
        <MudItem xs="12" md="5">
            <div class="pa-5 rounded-xl h-100"
                 style="background-color: var(--color-surface); border: 1px solid var(--color-rule); box-shadow: var(--shadow-sm); border-radius: 16px;">
                <div class="d-flex justify-space-between align-center mb-3">
                    <h2 style="font-size: 1.1rem; font-weight: 700; color: var(--color-ink); margin: 0;">
                        Upcoming assessments
                    </h2>
                    <MudButton Size="Size.Small"
                               Variant="Variant.Text"
                               Color="Color.Primary"
                               OnClick="@(() => Navigation.NavigateTo("/assessments"))"
                               Style="text-transform: none; font-weight: 600;">
                        View all
                    </MudButton>
                </div>

                @if (_stats.UpcomingAssessments?.Any() == true)
                {
                    <div class="d-flex flex-column gap-2">
                        @foreach (var test in _stats.UpcomingAssessments)
                        {
                            <div class="pa-3 rounded-lg d-flex justify-space-between align-center"
                                 style="background-color: var(--color-paper-subtle); border: 1px solid var(--color-rule); border-radius: 10px;">
                                <div class="d-flex align-center gap-3">
                                    <div style="width: 34px; height: 34px; border-radius: 8px; background-color: var(--color-primary-soft); display: flex; align-items: center; justify-content: center;">
                                        <MudIcon Icon="@Icons.Material.Outlined.EventNote" Style="color: var(--color-primary); font-size: 18px;" />
                                    </div>
                                    <div>
                                        <div style="font-weight: 600; font-size: 0.86rem; color: var(--color-ink);">@test.Name</div>
                                        <div style="font-size: 0.74rem; color: var(--color-ink-muted);">
                                            @test.GradeName • @test.SubjectCount subjects
                                        </div>
                                    </div>
                                </div>
                                <span class="adorable-badge adorable-badge-primary" style="font-size: 0.72rem; padding: 2px 8px;">
                                    @test.Date.ToString("MMM dd")
                                </span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="pa-6 text-center">
                        <div class="mx-auto mb-2" style="width: 48px; height: 48px; border-radius: 50%; background-color: var(--color-paper-subtle); display: flex; align-items: center; justify-content: center;">
                            <MudIcon Icon="@Icons.Material.Outlined.EventAvailable" Style="color: var(--color-ink-muted); font-size: 24px;" />
                        </div>
                        <p style="font-size: 0.85rem; color: var(--color-ink-muted); margin: 0;">No upcoming assessments scheduled</p>
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   Class="mt-2"
                                   OnClick="@(() => Navigation.NavigateTo("/assessments"))"
                                   Style="text-transform: none; font-weight: 600;">
                            Schedule a test
                        </MudButton>
                    </div>
                }
            </div>
        </MudItem>
    </MudGrid>
}

@code {
    private DashboardStatsDto? _stats;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboard();
    }

    private async Task LoadDashboard()
    {
        _loading = true;
        try
        {
            var res = await ApiService.GetDashboardStatsAsync();
            if (res?.Success == true)
            {
                _stats = res.Data;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading dashboard: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }
}

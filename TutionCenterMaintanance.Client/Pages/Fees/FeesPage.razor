@page "/fees"
@attribute [Authorize]
@inject IApiService ApiService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Fee Collection - Sai Tuition Center</PageTitle>

<!-- Header & Period Switcher -->
<div class="d-flex flex-column flex-sm-row justify-space-between align-start align-sm-center mb-5 gap-3">
    <div>
        <h1 style="font-size: 1.45rem; font-weight: 700; color: var(--color-ink); margin: 0; letter-spacing: -0.02em;">
            Tuition Fee Collection
        </h1>
        <p style="font-size: 0.85rem; color: var(--color-ink-secondary); margin: 3px 0 0 0;">
            Track monthly cash tuition fees for each student • 30–40 students strength
        </p>
    </div>
    <div class="d-flex align-center gap-2">
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.AccountBalance"
                   OnClick="@(() => Navigation.NavigateTo("/financials"))"
                   Style="border-radius: 10px; font-weight: 600; text-transform: none;">
            Financials & Expenses
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Secondary"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   OnClick="LoadData"
                   Disabled="_loading"
                   Style="border-radius: 10px; font-weight: 600; text-transform: none;">
            Refresh
        </MudButton>
    </div>
</div>

<!-- Month Navigator & Filter Bar -->
<div class="pa-3 rounded-xl mb-5 d-flex flex-wrap align-center justify-space-between gap-3"
     style="background-color: var(--color-surface); border: 1px solid var(--color-rule); box-shadow: var(--shadow-sm);">
    <!-- Month Navigator -->
    <div class="d-flex align-center gap-2">
        <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft"
                       Size="Size.Small"
                       OnClick="PrevMonth"
                       Title="Previous month" />
        <div style="font-weight: 700; font-size: 1.05rem; min-width: 140px; text-align: center; color: var(--color-ink);">
            @_currentMonthDate.ToString("MMMM yyyy")
        </div>
        <MudIconButton Icon="@Icons.Material.Filled.ChevronRight"
                       Size="Size.Small"
                       OnClick="NextMonth"
                       Title="Next month" />
        @if (_currentMonthDate.Month != DateTime.Today.Month || _currentMonthDate.Year != DateTime.Today.Year)
        {
            <MudButton Size="Size.Small"
                       Variant="Variant.Text"
                       Color="Color.Primary"
                       OnClick="GoToCurrentMonth"
                       Style="text-transform: none; font-size: 0.78rem;">
                Today
            </MudButton>
        }
    </div>

    <!-- Filters & Search -->
    <div class="d-flex align-center gap-2 flex-grow-1 justify-end flex-wrap" style="max-width: 550px;">
        <MudTextField @bind-Value="_searchQuery"
                      Placeholder="Search student by name..."
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Clearable="true"
                      Immediate="true"
                      Style="max-width: 240px; background-color: var(--color-surface);" />

        <MudSelect T="int"
                   Value="_selectedGradeId"
                   ValueChanged="OnGradeFilterChanged"
                   Label="Standard"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   Style="min-width: 150px; background-color: var(--color-surface);">
            <MudSelectItem Value="0">All Standards</MudSelectItem>
            @foreach (var g in _grades)
            {
                <MudSelectItem Value="@g.Id">@g.Name</MudSelectItem>
            }
        </MudSelect>

        <MudSelect T="string"
                   @bind-Value="_selectedStatusFilter"
                   Label="Status"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   Style="min-width: 130px; background-color: var(--color-surface);">
            <MudSelectItem Value="@("All")">All Status</MudSelectItem>
            <MudSelectItem Value="@("Paid")">Paid</MudSelectItem>
            <MudSelectItem Value="@("Partial")">Partial</MudSelectItem>
            <MudSelectItem Value="@("Unpaid")">Unpaid</MudSelectItem>
            <MudSelectItem Value="@("NoFee")">No Fee Set</MudSelectItem>
        </MudSelect>
    </div>
</div>

<!-- Fee Metrics Summary Cards (Hallmark styling) -->
<MudGrid Class="mb-5">
    <!-- Active Students & Paid Count -->
    <MudItem xs="12" sm="6" md="3">
        <div class="pa-4 rounded-xl card-hover-subtle"
             style="background-color: var(--color-surface); border: 1px solid var(--color-rule); box-shadow: var(--shadow-sm); border-radius: 16px;">
            <div class="d-flex justify-space-between align-start mb-2">
                <span style="font-size: 0.82rem; font-weight: 600; color: var(--color-ink-secondary);">Collection Progress</span>
                <div style="width: 36px; height: 36px; border-radius: 10px; background-color: var(--color-primary-soft); display: flex; align-items: center; justify-content: center;">
                    <MudIcon Icon="@Icons.Material.Outlined.People" Style="color: var(--color-primary); font-size: 18px;" />
                </div>
            </div>
            <div style="font-size: 1.6rem; font-weight: 700; color: var(--color-ink); letter-spacing: -0.02em; font-variant-numeric: tabular-nums;">
                @_paidStudentsCount / @_totalStudentsCount
            </div>
            <div class="d-flex align-center gap-1 mt-1">
                <span class="adorable-badge adorable-badge-primary" style="font-size: 0.7rem; padding: 2px 6px;">
                    @_collectionRate% paid this month
                </span>
            </div>
        </div>
    </MudItem>

    <!-- Total Expected Fees -->
    <MudItem xs="12" sm="6" md="3">
        <div class="pa-4 rounded-xl card-hover-subtle"
             style="background-color: var(--color-surface); border: 1px solid var(--color-rule); box-shadow: var(--shadow-sm); border-radius: 16px;">
            <div class="d-flex justify-space-between align-start mb-2">
                <span style="font-size: 0.82rem; font-weight: 600; color: var(--color-ink-secondary);">Total Expected Fees</span>
                <div style="width: 36px; height: 36px; border-radius: 10px; background-color: var(--color-info-soft); display: flex; align-items: center; justify-content: center;">
                    <MudIcon Icon="@Icons.Material.Outlined.ReceiptLong" Style="color: var(--color-info); font-size: 18px;" />
                </div>
            </div>
            <div style="font-size: 1.6rem; font-weight: 700; color: var(--color-ink); letter-spacing: -0.02em; font-variant-numeric: tabular-nums;">
                ₹@_totalExpectedSum.ToString("N0")
            </div>
            <span class="adorable-badge adorable-badge-neutral mt-1" style="font-size: 0.7rem; padding: 2px 6px;">
                Monthly fee total
            </span>
        </div>
    </MudItem>

    <!-- Total Collected -->
    <MudItem xs="12" sm="6" md="3">
        <div class="pa-4 rounded-xl card-hover-subtle"
             style="background-color: var(--color-surface); border: 1px solid var(--color-rule); box-shadow: var(--shadow-sm); border-radius: 16px;">
            <div class="d-flex justify-space-between align-start mb-2">
                <span style="font-size: 0.82rem; font-weight: 600; color: var(--color-ink-secondary);">Cash Collected</span>
                <div style="width: 36px; height: 36px; border-radius: 10px; background-color: var(--color-success-soft); display: flex; align-items: center; justify-content: center;">
                    <MudIcon Icon="@Icons.Material.Outlined.CheckCircleOutline" Style="color: var(--color-success); font-size: 18px;" />
                </div>
            </div>
            <div style="font-size: 1.6rem; font-weight: 700; color: var(--color-success); letter-spacing: -0.02em; font-variant-numeric: tabular-nums;">
                ₹@_totalPaidSum.ToString("N0")
            </div>
            <span class="adorable-badge adorable-badge-success mt-1" style="font-size: 0.7rem; padding: 2px 6px;">
                Received offline
            </span>
        </div>
    </MudItem>

    <!-- Pending Due -->
    <MudItem xs="12" sm="6" md="3">
        <div class="pa-4 rounded-xl card-hover-subtle"
             style="background-color: var(--color-surface); border: 1px solid var(--color-rule); box-shadow: var(--shadow-sm); border-radius: 16px;">
            <div class="d-flex justify-space-between align-start mb-2">
                <span style="font-size: 0.82rem; font-weight: 600; color: var(--color-ink-secondary);">Pending Balance</span>
                <div style="width: 36px; height: 36px; border-radius: 10px; background-color: var(--color-warning-soft); display: flex; align-items: center; justify-content: center;">
                    <MudIcon Icon="@Icons.Material.Outlined.HourglassTop" Style="color: var(--color-warning); font-size: 18px;" />
                </div>
            </div>
            <div style="font-size: 1.6rem; font-weight: 700; color: var(--color-warning); letter-spacing: -0.02em; font-variant-numeric: tabular-nums;">
                ₹@_totalDueSum.ToString("N0")
            </div>
            <span class="adorable-badge adorable-badge-warning mt-1" style="font-size: 0.7rem; padding: 2px 6px;">
                @_unpaidStudentsCount student(s) pending
            </span>
        </div>
    </MudItem>
</MudGrid>

<!-- Students Fee Table -->
<div class="rounded-xl overflow-hidden"
     style="background-color: var(--color-surface); border: 1px solid var(--color-rule); box-shadow: var(--shadow-sm);">
    @if (_loading)
    {
        <div class="pa-8 text-center">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            <div class="mt-2" style="font-size: 0.85rem; color: var(--color-ink-muted);">Loading student fee records...</div>
        </div>
    }
    else if (!FilteredStudents.Any())
    {
        <div class="pa-10 text-center">
            <MudIcon Icon="@Icons.Material.Outlined.SearchOff" Style="font-size: 40px; color: var(--color-ink-muted);" />
            <div class="mt-2" style="font-weight: 600; color: var(--color-ink);">No student fee records found</div>
            <div style="font-size: 0.85rem; color: var(--color-ink-secondary);">Try adjusting your search or standard filter</div>
        </div>
    }
    else
    {
        <MudTable Items="@FilteredStudents" Dense="true" Hover="true" Elevation="0" Class="modular-table">
            <HeaderContent>
                <MudTh>Student</MudTh>
                <MudTh>Standard</MudTh>
                <MudTh>Monthly Fee</MudTh>
                <MudTh>Paid This Month</MudTh>
                <MudTh>Balance Due</MudTh>
                <MudTh>Status</MudTh>
                <MudTh Style="text-align: right;">Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <!-- Student Name & Avatar -->
                <MudTd DataLabel="Student">
                    <div class="d-flex align-center gap-3">
                        <MudAvatar Size="Size.Medium" Style="width: 36px; height: 36px; font-weight: 700; background-color: var(--color-primary-soft); color: var(--color-primary);">
                            @if (!string.IsNullOrEmpty(context.PhotoUrl))
                            {
                                <MudImage Src="@context.PhotoUrl" Alt="@context.StudentName" ObjectFit="ObjectFit.Cover" />
                            }
                            else
                            {
                                @(string.IsNullOrEmpty(context.StudentName) ? "S" : context.StudentName[0].ToString().ToUpper())
                            }
                        </MudAvatar>
                        <div>
                            <div style="font-weight: 600; color: var(--color-ink); font-size: 0.88rem;">
                                @context.StudentName
                            </div>
                            @if (!string.IsNullOrWhiteSpace(context.PrimaryPhone))
                            {
                                <div style="font-size: 0.75rem; color: var(--color-ink-muted);">
                                    @context.ParentName • @context.PrimaryPhone
                                </div>
                            }
                        </div>
                    </div>
                </MudTd>

                <!-- Standard / Class -->
                <MudTd DataLabel="Standard">
                    <span class="adorable-badge adorable-badge-info" style="font-size: 0.72rem; padding: 2px 8px;">
                        @context.GradeName
                    </span>
                </MudTd>

                <!-- Monthly Fee Amount (Click to edit) -->
                <MudTd DataLabel="Monthly Fee">
                    <div class="d-flex align-center gap-1 cursor-pointer" @onclick="@(() => OpenSetMonthlyFee(context))" title="Click to change monthly fee">
                        @if (context.MonthlyFeeAmount > 0)
                        {
                            <span style="font-weight: 700; font-size: 0.9rem; color: var(--color-ink); font-variant-numeric: tabular-nums;">
                                ₹@context.MonthlyFeeAmount.ToString("N0")
                            </span>
                            <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Style="font-size: 14px; color: var(--color-ink-muted);" />
                        }
                        else
                        {
                            <span class="adorable-badge adorable-badge-neutral" style="font-size: 0.72rem; padding: 2px 6px;">
                                Set fee
                            </span>
                        }
                    </div>
                </MudTd>

                <!-- Paid This Month -->
                <MudTd DataLabel="Paid This Month">
                    <span style="font-weight: 700; font-size: 0.9rem; color: var(--color-success); font-variant-numeric: tabular-nums;">
                        ₹@context.PaidAmount.ToString("N0")
                    </span>
                    @if (context.PaymentCount > 1)
                    {
                        <span style="font-size: 0.7rem; color: var(--color-ink-muted);" class="ml-1">(@context.PaymentCount pymts)</span>
                    }
                </MudTd>

                <!-- Balance Due -->
                <MudTd DataLabel="Balance Due">
                    @if (context.RemainingAmount > 0)
                    {
                        <span style="font-weight: 700; font-size: 0.9rem; color: var(--color-warning); font-variant-numeric: tabular-nums;">
                            ₹@context.RemainingAmount.ToString("N0")
                        </span>
                    }
                    else
                    {
                        <span style="font-size: 0.85rem; color: var(--color-success);">₹0</span>
                    }
                </MudTd>

                <!-- Status Chip -->
                <MudTd DataLabel="Status">
                    @if (context.MonthlyFeeAmount <= 0)
                    {
                        <span class="adorable-badge adorable-badge-neutral" style="font-size: 0.72rem; padding: 3px 8px;">
                            Fee not set
                        </span>
                    }
                    else if (context.Status == PaymentStatus.Paid)
                    {
                        <span class="adorable-badge adorable-badge-success" style="font-size: 0.72rem; padding: 3px 8px;">
                            <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Style="font-size: 12px; margin-right: 2px;" /> Paid
                        </span>
                    }
                    else if (context.Status == PaymentStatus.PartiallyPaid)
                    {
                        <span class="adorable-badge adorable-badge-warning" style="font-size: 0.72rem; padding: 3px 8px;">
                            Partial (₹@context.RemainingAmount:N0 left)
                        </span>
                    }
                    else
                    {
                        <span class="adorable-badge adorable-badge-error" style="font-size: 0.72rem; padding: 3px 8px;">
                            Unpaid
                        </span>
                    }
                </MudTd>

                <!-- Actions -->
                <MudTd Style="text-align: right;">
                    <div class="d-flex align-center justify-end gap-1">
                        <!-- Record Cash Payment Button -->
                        @if (context.MonthlyFeeAmount > 0 && context.Status != PaymentStatus.Paid)
                        {
                            <MudButton Size="Size.Small"
                                       Variant="Variant.Filled"
                                       Color="Color.Success"
                                       StartIcon="@Icons.Material.Filled.Payments"
                                       OnClick="@(() => OpenRecordPayment(context))"
                                       Style="text-transform: none; font-size: 0.75rem; border-radius: 8px; font-weight: 600; padding: 4px 10px;">
                                Collect
                            </MudButton>
                        }
                        else if (context.MonthlyFeeAmount <= 0)
                        {
                            <MudButton Size="Size.Small"
                                       Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       OnClick="@(() => OpenSetMonthlyFee(context))"
                                       Style="text-transform: none; font-size: 0.75rem; border-radius: 8px;">
                                Set Fee
                            </MudButton>
                        }
                        else
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Add"
                                           Size="Size.Small"
                                           Color="Color.Success"
                                           Title="Record additional cash payment"
                                           OnClick="@(() => OpenRecordPayment(context))" />
                        }

                        <!-- History / Ledger -->
                        <MudIconButton Icon="@Icons.Material.Outlined.History"
                                       Size="Size.Small"
                                       Color="Color.Default"
                                       Title="Payment History"
                                       OnClick="@(() => OpenLedger(context.StudentId))" />

                        <!-- Mock WhatsApp Notify Button -->
                        @if (context.Status != PaymentStatus.Paid && context.MonthlyFeeAmount > 0)
                        {
                            <MudIconButton Icon="@Icons.Custom.Brands.WhatsApp"
                                           Size="Size.Small"
                                           Color="Color.Success"
                                           Title="Send reminder"
                                           OnClick="@(() => ShowMockWhatsAppSnackbar(context.StudentName))" />
                        }
                    </div>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</div>

@code {
    private DateTime _currentMonthDate = DateTime.Today;
    private List<StudentMonthlyStatusDto> _students = new();
    private List<GradeDto> _grades = new();
    private int _selectedGradeId = 0;
    private string _selectedStatusFilter = "All";
    private string _searchQuery = string.Empty;
    private bool _loading = true;

    private int _totalStudentsCount => _students.Count;
    private int _paidStudentsCount => _students.Count(s => s.Status == PaymentStatus.Paid);
    private int _unpaidStudentsCount => _students.Count(s => s.Status != PaymentStatus.Paid && s.MonthlyFeeAmount > 0);
    private decimal _totalExpectedSum => _students.Sum(s => s.MonthlyFeeAmount);
    private decimal _totalPaidSum => _students.Sum(s => s.PaidAmount);
    private decimal _totalDueSum => _students.Sum(s => s.RemainingAmount);
    private decimal _collectionRate => _totalExpectedSum > 0 ? Math.Round((_totalPaidSum / _totalExpectedSum) * 100, 1) : 0;

    private IEnumerable<StudentMonthlyStatusDto> FilteredStudents
    {
        get
        {
            var query = _students.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_searchQuery))
            {
                query = query.Where(s => s.StudentName.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
                                         s.PrimaryPhone.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase));
            }

            if (_selectedGradeId > 0)
            {
                // Note: GradeId is filtered in API or we filter by GradeName
            }

            if (_selectedStatusFilter == "Paid")
                query = query.Where(s => s.Status == PaymentStatus.Paid);
            else if (_selectedStatusFilter == "Partial")
                query = query.Where(s => s.Status == PaymentStatus.PartiallyPaid);
            else if (_selectedStatusFilter == "Unpaid")
                query = query.Where(s => s.Status == PaymentStatus.Pending && s.MonthlyFeeAmount > 0);
            else if (_selectedStatusFilter == "NoFee")
                query = query.Where(s => s.MonthlyFeeAmount <= 0);

            return query;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadGrades();
        await LoadData();
    }

    private async Task LoadGrades()
    {
        try
        {
            var res = await ApiService.GetGradesAsync();
            if (res?.Success == true && res.Data != null)
            {
                _grades = res.Data;
            }
        }
        catch { }
    }

    private async Task LoadData()
    {
        _loading = true;
        try
        {
            var res = await ApiService.GetMonthlyStatusAsync(
                _currentMonthDate.Month,
                _currentMonthDate.Year,
                _selectedGradeId > 0 ? _selectedGradeId : null);

            if (res?.Success == true && res.Data != null)
            {
                _students = res.Data;
            }
            else
            {
                _students = new();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading fees: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task PrevMonth()
    {
        _currentMonthDate = _currentMonthDate.AddMonths(-1);
        await LoadData();
    }

    private async Task NextMonth()
    {
        _currentMonthDate = _currentMonthDate.AddMonths(1);
        await LoadData();
    }

    private async Task GoToCurrentMonth()
    {
        _currentMonthDate = DateTime.Today;
        await LoadData();
    }

    private async Task OnGradeFilterChanged(int gradeId)
    {
        _selectedGradeId = gradeId;
        await LoadData();
    }

    private async Task OpenRecordPayment(StudentMonthlyStatusDto student)
    {
        var parameters = new DialogParameters
        {
            ["StudentId"] = student.StudentId,
            ["StudentName"] = student.StudentName,
            ["GradeName"] = student.GradeName,
            ["MonthlyFeeAmount"] = student.MonthlyFeeAmount,
            ["DueAmount"] = student.RemainingAmount
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<RecordPaymentDialog>("Record Cash Payment", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is int paymentId)
        {
            await LoadData();
            // Automatically offer receipt
            var rParams = new DialogParameters { ["PaymentId"] = paymentId };
            await DialogService.ShowAsync<PaymentReceiptDialog>("Official Receipt", rParams, options);
        }
    }

    private async Task OpenSetMonthlyFee(StudentMonthlyStatusDto student)
    {
        var parameters = new DialogParameters
        {
            ["StudentId"] = student.StudentId,
            ["StudentName"] = student.StudentName,
            ["CurrentAmount"] = student.MonthlyFeeAmount
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<SetMonthlyFeeDialog>("Set Monthly Fee", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await LoadData();
        }
    }

    private async Task OpenLedger(int studentId)
    {
        var parameters = new DialogParameters { ["StudentId"] = studentId };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        await DialogService.ShowAsync<StudentLedgerDialog>("Payment History", parameters, options);
    }

    private void ShowMockWhatsAppSnackbar(string studentName)
    {
        Snackbar.Add($"WhatsApp alerts coming soon for {studentName}. Feature not yet activated.", Severity.Info);
    }
}

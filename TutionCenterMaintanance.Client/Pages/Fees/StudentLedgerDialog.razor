@inject IApiService ApiService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center justify-space-between w-100 pr-2">
            <div class="d-flex align-center gap-2">
                <div style="width: 36px; height: 36px; border-radius: 10px; background-color: var(--color-primary-soft); display: flex; align-items: center; justify-content: center;">
                    <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Style="color: var(--color-primary); font-size: 20px;" />
                </div>
                <div>
                    <MudText Typo="Typo.h6" Class="fw-bold">Student Payment History</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">All offline cash fee receipts</MudText>
                </div>
            </div>
            @if (_ledger != null)
            {
                <span class="adorable-badge @(_ledger.PaidAmount > 0 ? "adorable-badge-success" : "adorable-badge-neutral")" style="font-size: 0.75rem; padding: 4px 10px;">
                    ₹@_ledger.PaidAmount.ToString("N0") Collected
                </span>
            }
        </div>
    </TitleContent>
    <DialogContent>
        @if (_loading)
        {
            <div class="d-flex justify-center my-8">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </div>
        }
        else if (_ledger == null)
        {
            <MudAlert Severity="Severity.Error">Could not load fee records for student.</MudAlert>
        }
        else
        {
            <!-- Student Header Card -->
            <div class="pa-4 rounded-xl mb-4" style="background-color: var(--color-paper-subtle); border: 1px solid var(--color-rule);">
                <MudGrid Spacing="2" Class="align-center">
                    <MudItem xs="12" sm="5">
                        <div style="font-weight: 700; font-size: 1.05rem; color: var(--color-ink);">@_ledger.StudentName</div>
                        <div style="font-size: 0.8rem; color: var(--color-ink-secondary);">
                            @_ledger.GradeName • @_ledger.BoardName
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_ledger.FatherName) || !string.IsNullOrWhiteSpace(_ledger.PrimaryPhone))
                        {
                            <div class="mt-1" style="font-size: 0.78rem; color: var(--color-ink-muted);">
                                Contact: @_ledger.FatherName (@_ledger.PrimaryPhone)
                            </div>
                        }
                    </MudItem>
                    <MudItem xs="6" sm="3" Class="text-center">
                        <div style="font-size: 0.75rem; color: var(--color-ink-muted);">Monthly Fee</div>
                        <div style="font-size: 1.15rem; font-weight: 700; color: var(--color-primary); font-variant-numeric: tabular-nums;">
                            ₹@_ledger.TotalFee.ToString("N0")
                        </div>
                        <div style="font-size: 0.7rem; color: var(--color-ink-muted);">per month</div>
                    </MudItem>
                    <MudItem xs="6" sm="4" Class="text-center">
                        <div style="font-size: 0.75rem; color: var(--color-ink-muted);">Total Cash Collected</div>
                        <div style="font-size: 1.25rem; font-weight: 700; color: var(--color-success); font-variant-numeric: tabular-nums;">
                            ₹@_ledger.PaidAmount.ToString("N0")
                        </div>
                        <div style="font-size: 0.7rem; color: var(--color-ink-muted);">@_ledger.Payments.Count receipt(s)</div>
                    </MudItem>
                </MudGrid>
            </div>

            <!-- Payments List -->
            <MudText Typo="Typo.subtitle2" Class="fw-bold mb-2">Cash Payment Receipts</MudText>
            @if (!_ledger.Payments.Any())
            {
                <div class="pa-6 text-center rounded-lg" style="border: 1px dashed var(--color-rule); color: var(--color-ink-muted);">
                    No cash payment receipts recorded yet for this student.
                </div>
            }
            else
            {
                <MudTable Items="@_ledger.Payments" Dense="true" Hover="true" Elevation="0" Outlined="true" Class="rounded-lg">
                    <HeaderContent>
                        <MudTh>Receipt #</MudTh>
                        <MudTh>Date</MudTh>
                        <MudTh>Amount</MudTh>
                        <MudTh>Remarks</MudTh>
                        <MudTh Style="text-align: right;">Action</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Receipt #">
                            <span style="font-weight: 600; color: var(--color-primary); font-size: 0.82rem;">
                                @context.ReceiptNumber
                            </span>
                        </MudTd>
                        <MudTd DataLabel="Date">
                            <span style="font-size: 0.82rem;">@context.PaymentDate.ToString("dd MMM yyyy")</span>
                        </MudTd>
                        <MudTd DataLabel="Amount">
                            <span style="font-weight: 700; color: var(--color-success); font-size: 0.88rem; font-variant-numeric: tabular-nums;">
                                ₹@context.Amount.ToString("N0")
                            </span>
                        </MudTd>
                        <MudTd DataLabel="Remarks">
                            <span style="font-size: 0.8rem; color: var(--color-ink-secondary);">
                                @(string.IsNullOrWhiteSpace(context.Remarks) ? "Tuition Fee Payment" : context.Remarks)
                            </span>
                        </MudTd>
                        <MudTd Style="text-align: right;">
                            <MudButton Size="Size.Small"
                                       Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Receipt"
                                       OnClick="@(() => OpenReceipt(context.Id))"
                                       Style="text-transform: none; font-size: 0.75rem; border-radius: 6px;">
                                Receipt
                            </MudButton>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close" Color="Color.Default">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public int StudentId { get; set; }

    private StudentFeeLedgerDto? _ledger;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadLedger();
    }

    private async Task LoadLedger()
    {
        _loading = true;
        try
        {
            var res = await ApiService.GetStudentFeeLedgerAsync(StudentId);
            if (res?.Success == true && res.Data != null)
            {
                _ledger = res.Data;
            }
            else
            {
                Snackbar.Add("Failed to load payment history.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenReceipt(int paymentId)
    {
        var parameters = new DialogParameters { ["PaymentId"] = paymentId };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        await DialogService.ShowAsync<PaymentReceiptDialog>("Official Receipt", parameters, options);
    }

    private void Close() => MudDialog.Close();
}

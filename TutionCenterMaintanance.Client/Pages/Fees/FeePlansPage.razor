@page "/fees/plans"
@attribute [Authorize]
@inject IApiService ApiService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Fee Plans & Discounts - Tuition Center</PageTitle>

<div class="d-flex justify-space-between align-center mb-4">
    <div>
        <MudText Typo="Typo.h5" Class="fw-bold">Fee Plans & Scholarships</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">Configure tuition fee structures, discount types, and student allocations</MudText>
    </div>
    <div class="d-flex gap-2">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreatePlanDialog">
            Add Fee Plan
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Discount" OnClick="OpenCreateDiscountDialog">
            Add Discount
        </MudButton>
    </div>
</div>

<MudGrid>
    <!-- Fee Plans Table -->
    <MudItem xs="12" md="7">
        <MudCard Elevation="2" Class="rounded-lg overflow-hidden">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6" Class="fw-bold">Active Fee Plans</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudTable Items="@_plans" Dense="true" Hover="true" Elevation="0">
                <HeaderContent>
                    <MudTh>Plan Name</MudTh>
                    <MudTh>Grade</MudTh>
                    <MudTh>Frequency</MudTh>
                    <MudTh>Amount (₹)</MudTh>
                    <MudTh>Year</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        <MudText Typo="Typo.subtitle2" Class="fw-bold">@context.Name</MudText>
                    </MudTd>
                    <MudTd>
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">@context.GradeName</MudChip>
                    </MudTd>
                    <MudTd>@context.Frequency</MudTd>
                    <MudTd><strong style="color: #10B981;">₹@context.Amount.ToString("N0")</strong></MudTd>
                    <MudTd>@context.AcademicYearName</MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <div class="pa-4 text-center">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">No fee plans created yet.</MudText>
                    </div>
                </NoRecordsContent>
            </MudTable>
        </MudCard>
    </MudItem>

    <!-- Discounts & Scholarships Table -->
    <MudItem xs="12" md="5">
        <MudCard Elevation="2" Class="rounded-lg overflow-hidden">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6" Class="fw-bold">Discounts & Scholarships</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudTable Items="@_discounts" Dense="true" Hover="true" Elevation="0">
                <HeaderContent>
                    <MudTh>Discount Name</MudTh>
                    <MudTh>Type</MudTh>
                    <MudTh>Value</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        <MudText Typo="Typo.subtitle2" Class="fw-bold">@context.Name</MudText>
                    </MudTd>
                    <MudTd>@context.Type</MudTd>
                    <MudTd>
                        <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled">
                            @(context.IsPercentage ? $"{context.Value}%" : $"₹{context.Value:N0}")
                        </MudChip>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <div class="pa-4 text-center">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">No discounts defined.</MudText>
                    </div>
                </NoRecordsContent>
            </MudTable>
        </MudCard>
    </MudItem>
</MudGrid>

<!-- Quick Dialog for Creating Fee Plan -->
<MudDialog @bind-Visible="_showPlanDialog" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Create Fee Plan</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12">
                <MudTextField @bind-Value="_newPlan.Name" Label="Plan Name *" Required="true" Placeholder="e.g. Grade 10 Monthly Comprehensive" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="int" @bind-Value="_newPlan.GradeId" Label="Grade *" Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (var g in _grades)
                    {
                        <MudSelectItem Value="@g.Id">@g.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="FeeFrequency" @bind-Value="_newPlan.Frequency" Label="Frequency *" Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem Value="FeeFrequency.Monthly">Monthly</MudSelectItem>
                    <MudSelectItem Value="FeeFrequency.Quarterly">Quarterly</MudSelectItem>
                    <MudSelectItem Value="FeeFrequency.HalfYearly">Half-Yearly</MudSelectItem>
                    <MudSelectItem Value="FeeFrequency.Yearly">Yearly</MudSelectItem>
                    <MudSelectItem Value="FeeFrequency.PerSubject">Per Subject</MudSelectItem>
                    <MudSelectItem Value="FeeFrequency.OneTime">One-Time</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudNumericField T="decimal" @bind-Value="_newPlan.Amount" Label="Amount (₹) *" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="int" @bind-Value="_newPlan.AcademicYearId" Label="Academic Year *" Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (var y in _years)
                    {
                        <MudSelectItem Value="@y.Id">@y.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showPlanDialog = false)">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveFeePlan">Create Plan</MudButton>
    </DialogActions>
</MudDialog>

<!-- Quick Dialog for Creating Discount -->
<MudDialog @bind-Visible="_showDiscountDialog" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Create Discount / Scholarship</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12">
                <MudTextField @bind-Value="_newDiscount.Name" Label="Discount Name *" Required="true" Placeholder="e.g. Sibling Concession, Merit Scholarship" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="DiscountType" @bind-Value="_newDiscount.Type" Label="Category" Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem Value="DiscountType.Scholarship">Scholarship</MudSelectItem>
                    <MudSelectItem Value="DiscountType.SiblingDiscount">Sibling Discount</MudSelectItem>
                    <MudSelectItem Value="DiscountType.EarlyBird">Early Bird</MudSelectItem>
                    <MudSelectItem Value="DiscountType.Custom">Custom</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudNumericField T="decimal" @bind-Value="_newDiscount.Value" Label="Value *" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" />
            </MudItem>
            <MudItem xs="12">
                <MudCheckBox T="bool" @bind-Value="_newDiscount.IsPercentage" Label="Value is Percentage (%)" Color="Color.Primary" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showDiscountDialog = false)">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveDiscount">Create Discount</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<FeePlanDto> _plans = new();
    private List<DiscountDto> _discounts = new();
    private List<GradeDto> _grades = new();
    private List<AcademicYearDto> _years = new();

    private bool _showPlanDialog = false;
    private bool _showDiscountDialog = false;
    private FeePlanDto _newPlan = new();
    private DiscountDto _newDiscount = new() { IsPercentage = true, Value = 10 };
    private DialogOptions _dialogOptions = new() { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };

    protected override async Task OnInitializedAsync()
    {
        var gRes = await ApiService.GetGradesAsync();
        if (gRes?.Success == true && gRes.Data != null) _grades = gRes.Data;

        var yRes = await ApiService.GetAcademicYearsAsync();
        if (yRes?.Success == true && yRes.Data != null) _years = yRes.Data;

        await LoadData();
    }

    private async Task LoadData()
    {
        var pRes = await ApiService.GetFeePlansAsync();
        if (pRes?.Success == true && pRes.Data != null) _plans = pRes.Data;

        var dRes = await ApiService.GetDiscountsAsync();
        if (dRes?.Success == true && dRes.Data != null) _discounts = dRes.Data;
    }

    private void OpenCreatePlanDialog()
    {
        _newPlan = new FeePlanDto
        {
            GradeId = _grades.FirstOrDefault()?.Id ?? 1,
            AcademicYearId = _years.FirstOrDefault(y => y.IsCurrent)?.Id ?? _years.FirstOrDefault()?.Id ?? 1,
            Amount = 1500,
            Frequency = FeeFrequency.Monthly
        };
        _showPlanDialog = true;
    }

    private async Task SaveFeePlan()
    {
        if (string.IsNullOrWhiteSpace(_newPlan.Name) || _newPlan.Amount <= 0)
        {
            Snackbar.Add("Please enter a valid plan name and amount.", Severity.Warning);
            return;
        }

        var res = await ApiService.CreateFeePlanAsync(_newPlan);
        if (res?.Success == true)
        {
            Snackbar.Add("Fee plan created successfully!", Severity.Success);
            _showPlanDialog = false;
            await LoadData();
        }
        else
        {
            Snackbar.Add(res?.Message ?? "Failed to create fee plan.", Severity.Error);
        }
    }

    private void OpenCreateDiscountDialog()
    {
        _newDiscount = new DiscountDto { IsPercentage = true, Value = 15, Type = DiscountType.SiblingDiscount };
        _showDiscountDialog = true;
    }

    private async Task SaveDiscount()
    {
        if (string.IsNullOrWhiteSpace(_newDiscount.Name) || _newDiscount.Value <= 0)
        {
            Snackbar.Add("Please enter a valid discount name and value.", Severity.Warning);
            return;
        }

        var res = await ApiService.CreateDiscountAsync(_newDiscount);
        if (res?.Success == true)
        {
            Snackbar.Add("Discount created successfully!", Severity.Success);
            _showDiscountDialog = false;
            await LoadData();
        }
        else
        {
            Snackbar.Add(res?.Message ?? "Failed to create discount.", Severity.Error);
        }
    }
}

@inject IApiService ApiService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <div style="width: 36px; height: 36px; border-radius: 10px; background-color: var(--color-success-soft); display: flex; align-items: center; justify-content: center;">
                <MudIcon Icon="@Icons.Material.Filled.Payments" Style="color: var(--color-success); font-size: 20px;" />
            </div>
            <div>
                <MudText Typo="Typo.h6" Class="fw-bold">Record Cash Fee Payment</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">Offline cash fee collection</MudText>
            </div>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="pa-3 rounded-lg mb-4" style="background-color: var(--color-paper-subtle); border: 1px solid var(--color-rule);">
            <div class="d-flex justify-space-between align-center">
                <div>
                    <div style="font-weight: 700; font-size: 1rem; color: var(--color-ink);">@StudentName</div>
                    <div style="font-size: 0.8rem; color: var(--color-ink-secondary);">@GradeName</div>
                </div>
                <div class="text-right">
                    <div style="font-size: 0.75rem; color: var(--color-ink-muted);">Monthly Fee</div>
                    <div style="font-size: 1.1rem; font-weight: 700; color: var(--color-primary); font-variant-numeric: tabular-nums;">
                        ₹@MonthlyFeeAmount.ToString("N0")
                    </div>
                </div>
            </div>
            @if (DueAmount > 0)
            {
                <div class="mt-2 pt-2 d-flex justify-space-between align-center" style="border-top: 1px dashed var(--color-rule);">
                    <span style="font-size: 0.82rem; color: var(--color-warning);">Current Pending for this Month:</span>
                    <span style="font-size: 0.95rem; font-weight: 700; color: var(--color-warning); font-variant-numeric: tabular-nums;">
                        ₹@DueAmount.ToString("N0")
                    </span>
                </div>
            }
        </div>

        <MudGrid Spacing="2">
            <MudItem xs="12">
                <MudNumericField T="decimal" @bind-Value="_model.Amount"
                                 Label="Payment Amount (₹) *"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Min="1"
                                 HelperText="Full or partial cash amount received" />
            </MudItem>
            <MudItem xs="12">
                <MudDatePicker @bind-Date="_date"
                               Label="Cash Received Date *"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               MaxDate="DateTime.Today" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_model.Remarks"
                              Label="Receipt Notes / Remarks (Optional)"
                              Placeholder="e.g. November tuition fee, partial installment 1"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Success"
                   Variant="Variant.Filled"
                   OnClick="SavePayment"
                   Disabled="_saving || _model.Amount <= 0">
            @if (_saving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Recording...</span>
            }
            else
            {
                <span class="d-flex align-center gap-1">
                    <MudIcon Icon="@Icons.Material.Filled.Receipt" Size="Size.Small" />
                    <span>Confirm & Generate Receipt</span>
                </span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public int StudentId { get; set; }

    [Parameter]
    public string StudentName { get; set; } = string.Empty;

    [Parameter]
    public string GradeName { get; set; } = string.Empty;

    [Parameter]
    public decimal MonthlyFeeAmount { get; set; }

    [Parameter]
    public decimal DueAmount { get; set; }

    private RecordPaymentRequest _model = new();
    private DateTime? _date = DateTime.Today;
    private bool _saving = false;

    protected override void OnInitialized()
    {
        _model.StudentId = StudentId;
        // Pre-fill with remaining due amount if > 0, else default monthly fee
        _model.Amount = DueAmount > 0 ? DueAmount : (MonthlyFeeAmount > 0 ? MonthlyFeeAmount : 1000);
        _model.PaymentMode = PaymentMode.Cash;
    }

    private async Task SavePayment()
    {
        if (_model.Amount <= 0)
        {
            Snackbar.Add("Please enter a valid payment amount.", Severity.Warning);
            return;
        }

        _model.PaymentDate = _date ?? DateTime.Today;
        _model.PaymentMode = PaymentMode.Cash;
        _saving = true;

        try
        {
            var res = await ApiService.RecordPaymentAsync(_model);
            if (res?.Success == true && res.Data != null)
            {
                Snackbar.Add($"Cash payment of ₹{_model.Amount:N0} recorded! Receipt {res.Data.ReceiptNumber} issued.", Severity.Success);
                MudDialog.Close(DialogResult.Ok(res.Data.Id));
            }
            else
            {
                Snackbar.Add(res?.Message ?? "Failed to record payment.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}

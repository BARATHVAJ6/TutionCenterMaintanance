@page "/login"
@attribute [AllowAnonymous]
@inject IApiService ApiService
@inject ILocalStorageService LocalStorage
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<div class="d-flex justify-center align-center pa-4" style="min-height: 85vh;">
    <div style="width: 100%; max-width: 420px;">
        <!-- Clean, Adorable Login Card -->
        <div class="pa-6 pa-sm-8 rounded-xl"
             style="background-color: var(--color-surface); border: 1px solid var(--color-rule); box-shadow: var(--shadow-md); border-radius: 20px;">

            <!-- Header Badge & Title (No AI Gradients) -->
            <div class="text-center mb-6">
                <div class="mx-auto mb-3"
                     style="width: 56px; height: 56px; border-radius: 16px; background-color: var(--color-primary-soft); border: 1px solid var(--color-primary-border); display: flex; align-items: center; justify-content: center;">
                    <MudIcon Icon="@Icons.Material.Filled.School" Style="color: var(--color-primary); font-size: 28px;" />
                </div>
                <h1 style="font-size: 1.4rem; font-weight: 700; color: var(--color-ink); margin-bottom: 6px; letter-spacing: -0.02em;">
                    Sai Tuition Center
                </h1>
                <p style="font-size: 0.88rem; color: var(--color-ink-secondary); margin: 0; line-height: 1.4;">
                    Sign in to manage student records, marks, and fees
                </p>
            </div>

            <!-- Login Form -->
            <EditForm Model="@_loginModel" OnValidSubmit="HandleLogin">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label style="display: block; font-size: 0.82rem; font-weight: 600; color: var(--color-ink-secondary); margin-bottom: 6px;">
                        Username or email
                    </label>
                    <MudTextField @bind-Value="_loginModel.UserName"
                                  Placeholder="e.g. admin"
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Outlined.Person"
                                  Margin="Margin.Dense"
                                  For="@(() => _loginModel.UserName)" />
                </div>

                <div class="mb-4">
                    <label style="display: block; font-size: 0.82rem; font-weight: 600; color: var(--color-ink-secondary); margin-bottom: 6px;">
                        Password
                    </label>
                    <MudTextField @bind-Value="_loginModel.Password"
                                  Placeholder="Enter password"
                                  Variant="Variant.Outlined"
                                  InputType="@_passwordInputType"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@_passwordIcon"
                                  OnAdornmentClick="TogglePasswordVisibility"
                                  Margin="Margin.Dense"
                                  For="@(() => _loginModel.Password)" />
                </div>

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="pa-3 mb-4 rounded-lg" style="background-color: var(--color-error-soft); border: 1px solid var(--color-error); font-size: 0.82rem; color: var(--color-error);">
                        @_errorMessage
                    </div>
                }

                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Size="Size.Large"
                           Disabled="_loading"
                           Class="mt-2"
                           Style="height: 44px; font-weight: 600; font-size: 0.95rem; border-radius: 10px;">
                    @if (_loading)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                        <span class="ms-2">Signing in...</span>
                    }
                    else
                    {
                        <span>Sign in</span>
                    }
                </MudButton>
            </EditForm>

            <!-- Delightful Demo Credentials Quick-Fill Pill -->
            <div class="mt-6 pa-3 rounded-lg"
                 style="background-color: var(--color-paper-subtle); border: 1px solid var(--color-rule); cursor: pointer;"
                 @onclick="FillDemoCredentials"
                 title="Click to auto-fill default admin credentials">
                <div class="d-flex align-center justify-space-between mb-1">
                    <span style="font-size: 0.76rem; font-weight: 700; color: var(--color-ink-muted);">
                        Demo credentials
                    </span>
                    <span class="adorable-badge adorable-badge-primary" style="font-size: 0.68rem; padding: 1px 6px;">
                        Click to auto-fill
                    </span>
                </div>
                <div class="d-flex justify-space-between align-center" style="font-size: 0.8rem; color: var(--color-ink-secondary);">
                    <span>User: <strong>admin</strong></span>
                    <span>Pass: <strong>Admin@123</strong></span>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private readonly LoginRequest _loginModel = new() { UserName = "admin", Password = "Admin@123" };
    private bool _loading = false;
    private string? _errorMessage;
    private bool _showPassword = false;
    private InputType _passwordInputType => _showPassword ? InputType.Text : InputType.Password;
    private string _passwordIcon => _showPassword ? Icons.Material.Outlined.Visibility : Icons.Material.Outlined.VisibilityOff;

    private void TogglePasswordVisibility() => _showPassword = !_showPassword;

    private void FillDemoCredentials()
    {
        _loginModel.UserName = "admin";
        _loginModel.Password = "Admin@123";
        Snackbar.Add("Demo credentials filled", Severity.Info);
    }

    private async Task HandleLogin()
    {
        _loading = true;
        _errorMessage = null;

        try
        {
            var res = await ApiService.LoginAsync(_loginModel);
            if (res?.Success == true && res.Data != null)
            {
                await LocalStorage.SetItemAsync("authToken", res.Data.Token);
                ((CustomAuthStateProvider)AuthStateProvider).NotifyUserAuthentication(res.Data.Token);
                Snackbar.Add("Welcome back to Sai Tuition Center!", Severity.Success);
                Navigation.NavigateTo("/", forceLoad: false);
            }
            else
            {
                _errorMessage = res?.Message ?? "Invalid username or password";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Sign in failed: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }
}

<div class="d-flex flex-column justify-space-between h-100 pa-2">
    <MudNavMenu Rounded="true" Margin="Margin.Dense" Color="Color.Primary" Class="gap-1">
        <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Dashboard" IconColor="Color.Primary" Class="rounded-lg mb-1" Style="font-weight: 600;">
            Dashboard
        </MudNavLink>

        <MudNavGroup Title="Students" Icon="@Icons.Material.Outlined.People" Expanded="true" Class="mt-1">
            <MudNavLink Href="/students" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Badge" Class="rounded-lg">
                Student Directory
            </MudNavLink>
            <MudNavLink Href="/attendance" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.FactCheck" Class="rounded-lg">
                Daily Attendance
            </MudNavLink>
        </MudNavGroup>

        <MudNavGroup Title="Performance & Marks" Icon="@Icons.Material.Outlined.Analytics" Expanded="true" Class="mt-1">
            <MudNavLink Href="/assessments" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Assignment" Class="rounded-lg">
                Tests & Exams
            </MudNavLink>
            <MudNavLink Href="/marks/bulk-entry" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.FormatListNumbered" Class="rounded-lg">
                Bulk Marks Entry
            </MudNavLink>
            <MudNavLink Href="/report-cards" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Description" Class="rounded-lg">
                Report Cards
            </MudNavLink>
            <MudNavLink Href="/reports" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Insights" Class="rounded-lg">
                Analytics & Reports
            </MudNavLink>
        </MudNavGroup>

        <MudNavGroup Title="Fees & Financials" Icon="@Icons.Material.Outlined.Payments" Expanded="true" Class="mt-1">
            <MudNavLink Href="/fees" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.ReceiptLong" Class="rounded-lg">
                Fee Collection
            </MudNavLink>
            <MudNavLink Href="/financials" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.AccountBalance" Class="rounded-lg">
                Financials & Inventory
            </MudNavLink>
        </MudNavGroup>

        <MudNavGroup Title="Batches & Academics" Icon="@Icons.Material.Outlined.School" Expanded="false" Class="mt-1">
            <MudNavLink Href="/batches" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Groups" Class="rounded-lg">
                Class Batches
            </MudNavLink>
            <MudNavLink Href="/timetable" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.CalendarMonth" Class="rounded-lg">
                Weekly Timetable
            </MudNavLink>
            <MudNavLink Href="/homework" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.MenuBook" Class="rounded-lg">
                Homework & Tasks
            </MudNavLink>
            <MudNavLink Href="/academic-setup" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.LibraryBooks" Class="rounded-lg">
                Boards & Subjects
            </MudNavLink>
            <MudNavLink Href="/teachers" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Psychology" Class="rounded-lg">
                Teachers & Tutors
            </MudNavLink>
        </MudNavGroup>

        <MudNavGroup Title="Communication" Icon="@Icons.Material.Outlined.Forum" Expanded="false" Class="mt-1">
            <MudNavLink Href="/whatsapp" Match="NavLinkMatch.Prefix" Icon="@Icons.Custom.Brands.WhatsApp" Class="rounded-lg">
                WhatsApp to Parents
            </MudNavLink>
        </MudNavGroup>

        <MudNavGroup Title="Administration & IAM" Icon="@Icons.Material.Outlined.AdminPanelSettings" Expanded="false" Class="mt-1">
            <MudNavLink Href="/users" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.ManageAccounts" Class="rounded-lg">
                Users & Roles
            </MudNavLink>
            <MudNavLink Href="/data-management" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Storage" Class="rounded-lg">
                Backup & Data
            </MudNavLink>
            <MudNavLink Href="/audit" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Fingerprint" Class="rounded-lg">
                Audit Trail Logs
            </MudNavLink>
            <MudNavLink Href="/settings" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Outlined.Tune" Class="rounded-lg">
                Center Settings
            </MudNavLink>
        </MudNavGroup>
    </MudNavMenu>

    <!-- Drawer Footer Card -->
    <div class="pa-3 mt-4 rounded-xl" style="background-color: var(--color-paper-subtle); border: 1px solid var(--color-rule);">
        <div class="d-flex align-center justify-space-between">
            <div class="d-flex align-center gap-2">
                <div style="width: 8px; height: 8px; border-radius: 50%; background-color: var(--color-success);"></div>
                <span style="font-size: 0.76rem; font-weight: 600; color: var(--color-ink-secondary);">Local SQLite active</span>
            </div>
            <span style="font-size: 0.72rem; color: var(--color-ink-muted);">v1.0</span>
        </div>
    </div>
</div>

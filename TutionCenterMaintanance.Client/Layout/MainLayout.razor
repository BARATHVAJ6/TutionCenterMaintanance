@inherits LayoutComponentBase
@using TutionCenterMaintanance.Client.Pages.Auth
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject ILocalStorageService LocalStorage
@inject IApiService ApiService
@inject ISnackbar Snackbar

<MudThemeProvider @ref="_mudThemeProvider" Theme="_customTheme" IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<AuthorizeView>
    <Authorized>
        <MudLayout>
            <!-- Modern Crisp AppBar with Hairline Border -->
            <MudAppBar Elevation="0" Class="border-b" Style="border-bottom: 1px solid var(--color-rule) !important; background-color: var(--color-surface); height: 64px;">
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Default" Edge="Edge.Start" OnClick="@ToggleDrawer" Class="mr-2" />
                
                <!-- Adorable Brand Lockup -->
                <div class="d-flex align-center gap-2 cursor-pointer" @onclick="@(() => Navigation.NavigateTo("/"))">
                    <div style="width: 36px; height: 36px; border-radius: 10px; background-color: var(--color-primary-soft); display: flex; align-items: center; justify-content: center;">
                        <MudIcon Icon="@Icons.Material.Filled.School" Style="color: var(--color-primary); font-size: 20px;" />
                    </div>
                    <div>
                        <div class="d-flex align-center gap-2">
                            <span style="font-weight: 700; font-size: 1.05rem; color: var(--color-ink); letter-spacing: -0.01em;">
                                @(_settings?.CenterName ?? "Sai Tuition Center")
                            </span>
                            <span class="adorable-badge adorable-badge-primary d-none d-sm-inline-flex" style="font-size: 0.72rem; padding: 2px 8px;">
                                @(_settings?.Tagline ?? "UKG – 12th")
                            </span>
                        </div>
                    </div>
                </div>

                <MudSpacer />

                <!-- In-App Notification Bell Menu -->
                <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true">
                    <ActivatorContent Context="notifContext">
                        <MudTooltip Text="Notifications & alerts">
                            <MudBadge Content="@_unreadCount" Visible="@(_unreadCount > 0)" Color="Color.Error" Overlap="true" Class="mx-2">
                                <MudIconButton Icon="@Icons.Material.Outlined.Notifications" Color="Color.Default" />
                            </MudBadge>
                        </MudTooltip>
                    </ActivatorContent>
                    <ChildContent>
                        <div style="width: 360px; max-width: 90vw;" class="pa-3">
                            <div class="d-flex justify-space-between align-center pb-2 mb-2" style="border-bottom: 1px solid var(--color-rule);">
                                <div class="d-flex align-center gap-2">
                                    <span style="font-weight: 700; font-size: 0.95rem; color: var(--color-ink);">Notifications</span>
                                    @if (_unreadCount > 0)
                                    {
                                        <span class="adorable-badge adorable-badge-error" style="font-size: 0.7rem; padding: 2px 6px;">@_unreadCount new</span>
                                    }
                                </div>
                                <div class="d-flex gap-1">
                                    <MudTooltip Text="Scan & generate system alerts">
                                        <MudIconButton Icon="@Icons.Material.Filled.Sync" Size="Size.Small" Color="Color.Primary" OnClick="TriggerSystemAlerts" />
                                    </MudTooltip>
                                    @if (_unreadCount > 0)
                                    {
                                        <MudTooltip Text="Mark all as read">
                                            <MudIconButton Icon="@Icons.Material.Filled.DoneAll" Size="Size.Small" Color="Color.Default" OnClick="MarkAllNotificationsRead" />
                                        </MudTooltip>
                                    }
                                </div>
                            </div>

                            <div style="max-height: 320px; overflow-y: auto;">
                                @if (!_notifications.Any())
                                {
                                    <div class="pa-4 text-center">
                                        <div style="width: 44px; height: 44px; border-radius: 50%; background-color: var(--color-paper-subtle); display: inline-flex; align-items: center; justify-content: center; margin-bottom: 8px;">
                                            <MudIcon Icon="@Icons.Material.Outlined.NotificationsNone" Style="color: var(--color-ink-muted);" Size="Size.Medium" />
                                        </div>
                                        <span style="display: block; font-size: 0.825rem; color: var(--color-ink-muted);">All caught up! No notifications</span>
                                    </div>
                                }
                                else
                                {
                                    @foreach (var n in _notifications)
                                    {
                                        <div class="pa-2 mb-2 rounded-lg cursor-pointer"
                                             style="background-color: @(n.IsRead ? "transparent" : "var(--color-primary-soft)"); border-left: 3px solid @GetNotifBorderColor(n.Type); border-radius: 8px;"
                                             @onclick="@(() => MarkAsRead(n.Id))">
                                            <div class="d-flex align-center justify-space-between">
                                                <span style="font-weight: 600; font-size: 0.82rem; color: var(--color-ink);">
                                                    @n.Title
                                                </span>
                                                <span style="font-size: 0.68rem; color: var(--color-ink-muted);">
                                                    @GetTimeAgo(n.CreatedAt)
                                                </span>
                                            </div>
                                            <span style="font-size: 0.78rem; color: var(--color-ink-secondary); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin-top: 2px;">
                                                @n.Message
                                            </span>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </ChildContent>
                </MudMenu>

                <!-- Dark Mode Toggle -->
                <MudTooltip Text="Toggle theme">
                    <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Outlined.LightMode : Icons.Material.Outlined.DarkMode)"
                                   Color="Color.Default"
                                   OnClick="@ToggleDarkMode"
                                   Class="mr-1" />
                </MudTooltip>

                <!-- User Profile Pill -->
                <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                    <ActivatorContent Context="menuContext">
                        <div class="d-flex align-center gap-2 pa-1 px-2 rounded-pill cursor-pointer"
                             style="border: 1px solid var(--color-rule); background-color: var(--color-paper-subtle);">
                            <div style="width: 28px; height: 28px; border-radius: 50%; background-color: var(--color-primary); color: white; display: flex; align-items: center; justify-content: center; font-size: 0.8rem; font-weight: 700;">
                                @((context.User.Identity?.Name ?? "U")[0].ToString().ToUpper())
                            </div>
                            <span class="d-none d-sm-inline" style="font-size: 0.85rem; font-weight: 600; color: var(--color-ink);">
                                @context.User.Identity?.Name
                            </span>
                            <MudIcon Icon="@Icons.Material.Filled.ArrowDropDown" Size="Size.Small" Style="color: var(--color-ink-muted);" />
                        </div>
                    </ActivatorContent>
                    <ChildContent>
                        <div class="pa-3 border-b" style="border-bottom: 1px solid var(--color-rule); min-width: 180px;">
                            <div style="font-weight: 700; font-size: 0.88rem; color: var(--color-ink);">@context.User.Identity?.Name</div>
                            <div style="font-size: 0.76rem; color: var(--color-ink-muted);">Role: @(context.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "User")</div>
                        </div>
                        <MudMenuItem Icon="@Icons.Material.Outlined.Settings" Href="/settings">Center Settings</MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Outlined.Logout" OnClick="@HandleLogout">Sign out</MudMenuItem>
                    </ChildContent>
                </MudMenu>
            </MudAppBar>

            <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="0" Variant="DrawerVariant.Responsive" Style="border-right: 1px solid var(--color-rule) !important; background-color: var(--color-surface);">
                <NavMenu />
            </MudDrawer>

            <MudMainContent Class="px-4 px-md-6 pb-6" Style="background-color: var(--color-paper); min-height: 100vh; padding-top: calc(var(--mud-appbar-height, 64px) + 24px) !important;">
                <div class="adorable-container">
                    @Body
                </div>
            </MudMainContent>
        </MudLayout>
    </Authorized>
    <NotAuthorized>
        <Login />
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode = false;
    private MudThemeProvider? _mudThemeProvider;
    private CenterSettingsDto? _settings;
    private int _unreadCount = 0;
    private List<NotificationDto> _notifications = new();

    private readonly MudTheme _customTheme = new()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#3B49DF",
            PrimaryContrastText = "#FFFFFF",
            Secondary = "#0D9488",
            SecondaryContrastText = "#FFFFFF",
            AppbarBackground = "#FFFFFF",
            AppbarText = "#0F172A",
            Background = "#F8FAFC",
            BackgroundGray = "#F1F5F9",
            Surface = "#FFFFFF",
            DrawerBackground = "#FFFFFF",
            DrawerText = "#334155",
            DrawerIcon = "#64748B",
            TextPrimary = "#0F172A",
            TextSecondary = "#475569",
            Divider = "#E2E8F0",
            LinesDefault = "#E2E8F0",
            LinesInputs = "#E2E8F0",
            Success = "#10B981",
            Warning = "#D97706",
            Error = "#EF4444",
            Info = "#3B82F6"
        },
        PaletteDark = new PaletteDark()
        {
            Primary = "#6366F1",
            Secondary = "#14B8A6",
            AppbarBackground = "#0F172A",
            AppbarText = "#F8FAFC",
            Background = "#0B0F17",
            BackgroundGray = "#111827",
            Surface = "#151D2C",
            DrawerBackground = "#111827",
            DrawerText = "#E2E8F0",
            DrawerIcon = "#94A3B8",
            TextPrimary = "#F8FAFC",
            TextSecondary = "#94A3B8",
            Divider = "#1E293B",
            LinesDefault = "#1E293B",
            LinesInputs = "#334155",
            Success = "#10B981",
            Warning = "#F59E0B",
            Error = "#EF4444",
            Info = "#60A5FA"
        },
        Typography = new Typography()
        {
            Default = new DefaultTypography()
            {
                FontFamily = new[] { "Plus Jakarta Sans", "Segoe UI", "sans-serif" }
            }
        },
        LayoutProperties = new LayoutProperties()
        {
            DefaultBorderRadius = "12px"
        }
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var res = await ApiService.GetSettingsAsync();
            if (res?.Success == true)
            {
                _settings = res.Data;
            }

            await LoadNotifications();
        }
        catch { }
    }

    private async Task LoadNotifications()
    {
        try
        {
            var countRes = await ApiService.GetUnreadNotificationCountAsync();
            if (countRes?.Success == true && countRes.Data != null)
            {
                _unreadCount = countRes.Data.UnreadCount;
            }

            var notifRes = await ApiService.GetNotificationsAsync();
            if (notifRes?.Success == true && notifRes.Data != null)
            {
                _notifications = notifRes.Data;
            }
        }
        catch { }
    }

    private async Task MarkAsRead(int id)
    {
        await ApiService.MarkNotificationAsReadAsync(id);
        var n = _notifications.FirstOrDefault(x => x.Id == id);
        if (n != null && !n.IsRead)
        {
            n.IsRead = true;
            _unreadCount = Math.Max(0, _unreadCount - 1);
        }
    }

    private async Task MarkAllNotificationsRead()
    {
        await ApiService.MarkAllNotificationsAsReadAsync();
        foreach (var n in _notifications) n.IsRead = true;
        _unreadCount = 0;
        Snackbar.Add("All notifications marked as read", Severity.Info);
    }

    private async Task TriggerSystemAlerts()
    {
        var res = await ApiService.GenerateSystemAlertsAsync();
        if (res?.Success == true)
        {
            Snackbar.Add($"Alert scan complete: {res.Data} new notification(s) generated", Severity.Success);
            await LoadNotifications();
        }
    }

    private static string GetNotifBorderColor(string type) => type switch
    {
        "Success" => "var(--color-success)",
        "Warning" => "var(--color-warning)",
        "Error" => "var(--color-error)",
        _ => "var(--color-primary)"
    };

    private static string GetTimeAgo(DateTime dt)
    {
        var span = DateTime.UtcNow - dt;
        if (span.TotalMinutes < 2) return "Just now";
        if (span.TotalHours < 1) return $"{(int)span.TotalMinutes}m ago";
        if (span.TotalDays < 1) return $"{(int)span.TotalHours}h ago";
        return dt.ToString("dd MMM");
    }

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
    private void ToggleDarkMode() => _isDarkMode = !_isDarkMode;

    private async Task HandleLogout()
    {
        await LocalStorage.RemoveItemAsync("authToken");
        ((CustomAuthStateProvider)AuthStateProvider).NotifyUserLogout();
        Snackbar.Add("Signed out successfully", Severity.Info);
        Navigation.NavigateTo("/login");
    }
}
